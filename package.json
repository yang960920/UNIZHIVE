{
  "name": "uniz-hive",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @uniz/web dev",
    "start": "pnpm --filter @uniz/web start",
    "build": "pnpm --filter @uniz/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @uniz/db generate",
    "db:migrate": "pnpm --filter @uniz/db migrate",
    "db:verify": "pnpm --filter @uniz/db verify",
    "auth:verify": "node apps/web/scripts/verify-discord.mjs",
    "ops:verify": "vitest run --config vitest.integration.config.ts",
    "admin:bootstrap": "node --conditions=react-server apps/web/scripts/bootstrap-admin.mjs",
    "admin:bootstrap:production": "node --conditions=react-server apps/web/scripts/bootstrap-production-admin.mjs",
    "data:verify": "pnpm --filter @uniz/build-engine verify:data"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.4.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
