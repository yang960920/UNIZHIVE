# Copy to apps/web/.env.local. Values below contain no credentials.
# Development mock login is enabled only in development unless set to false.
# Production always rejects MOCK_AUTH=true and rejects mock sessions.
MOCK_AUTH=
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
DATABASE_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
STEAM_APP_ID=2139460
# Public Steam news/count are enabled without an API key.
STEAM_API_KEY=
# Vercel builds use the exact pnpm version pinned in package.json.
ENABLE_EXPERIMENTAL_COREPACK=1
# /map uses the four verified Korean TH.GL map URLs; no embed configuration is needed.
# Game information shows one labelled fictitious DPS record; off hides all game-info examples.
GAME_INFO_EXAMPLES=single
